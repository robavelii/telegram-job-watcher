# Copy to .env next to docker-compose.yml, fill in, chmod 600. Never commit it.

# From https://my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# From gen_session.py, run on your laptop. Full access to your account: treat as a password.
TELEGRAM_SESSION_STRING=
# Folder title, matched case-insensitively
TELEGRAM_FOLDER_NAME=remote-jobs

# Notifier bot from @BotFather. Press Start on it once.
BOT_TOKEN=
# Your Telegram user id (gen_session.py prints it)
NOTIFY_CHAT_ID=

# Model provider: gemini or anthropic. Empty = whichever key below is set (Gemini first).
LLM_PROVIDER=gemini
# Empty = the provider's default: gemini-3.5-flash-lite or claude-haiku-5-5
LLM_MODEL=
# From https://aistudio.google.com/apikey. On the free tier Google may use prompts to
# improve its products and human reviewers may read them; see README > Privacy.
GEMINI_API_KEY=
# From https://platform.claude.com, only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Claude only: low | medium | high
CLAUDE_EFFORT=medium

# Ping when is_job_posting, fit_score >= FIT_THRESHOLD and eligibility is not "no"
FIT_THRESHOLD=70
# Near misses (NEAR_MISS_MIN..FIT_THRESHOLD-1) go to the daily digest
NEAR_MISS_MIN=50
# Posts shorter than this never reach the API
MIN_POST_CHARS=200
# First start only: also score the last N posts per channel
BACKFILL_PER_CHANNEL=0
FOLDER_REFRESH_SECONDS=900

TZ_NAME=Africa/Addis_Ababa
# Hold alerts during these hours and send them when they end. Empty = off. Example: 23:00-07:00
QUIET_HOURS=
# Daily near-miss digest time. Empty = off. Example: 20:00
DAILY_DIGEST_AT=

# 1 = log messages instead of sending them
DRY_RUN=0
LOG_LEVEL=INFO
